# SPA fallback for React Router on Apache/LiteSpeed (IDCloudHost)
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # If app is deployed in a subfolder, set RewriteBase accordingly.
  # Example: RewriteBase /demo_lms_v2/
  RewriteBase /

  # Let existing files/directories pass through.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Send all other requests to the SPA entrypoint.
  RewriteRule ^ index.html [L]
</IfModule>
